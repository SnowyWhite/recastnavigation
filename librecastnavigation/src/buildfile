# Recast (navigation mesh construction), Detour (the runtime: navigation
# mesh, queries, pathfinding), DetourCrowd (agent steering), DetourTileCache
# (tile caching with obstacles) and DebugUtils (debug drawing and dumps),
# built as one library, which is how upstream's pkg-config file presents
# them (-lRecast -lDetour -lDetourCrowd -lDetourTileCache -lDebugUtils).
#

# Public headers.
#
pub = [dir_path] ../include/recastnavigation/

include $pub

pub_hdrs = $($pub/ pub_hdrs)

lib{recastnavigation}: libul{recastnavigation}: $pub/{$pub_hdrs}

# Sources: the Source/ directory of each upstream component, symlinked.
#
libul{recastnavigation}: cxx{**}

libs{recastnavigation}: def{recastnavigation}: include = ($cxx.target.system == 'win32-msvc')
def{recastnavigation}: libul{recastnavigation}

# Build options.
#
# Upstream includes its public headers without a directory prefix
# ("Recast.h", <DetourNavMesh.h>), as its users do, and installs them into
# include/recastnavigation/ with both that directory and include/ on the
# search path (recastnavigation.pc). The same here: the headers are in
# include/recastnavigation/, and both ways of including them work, for the
# library's own sources and for its consumers.
#
src_pfx_inc = [dir_path] $src_root/include/
src_pfx_inc_unq = [dir_path] $src_root/include/recastnavigation/

cxx.poptions =+ "-I$src_pfx_inc" "-I$src_pfx_inc_unq"

# The virtual query filter changes dtQueryFilter's layout (a vtable), so the
# define is exported along with the include directories: the library and
# everything compiled against its headers have to agree on it.
#
defs =

if $config.librecastnavigation.virtual_query_filter
  defs += -DDT_VIRTUAL_QUERYFILTER=1

cxx.poptions += $defs

if ($cxx.target.system == 'mingw32')
  cxx.loptions += -Wl,--export-all-symbols

# Export options.
#
lib{recastnavigation}:
{
  cxx.export.poptions = "-I$src_pfx_inc" "-I$src_pfx_inc_unq" $defs
}

# Make sure headers installed into, say, /usr/include/recastnavigation/ can
# also be included without the directory prefix, as upstream arranges.
#
lib{recastnavigation}: cxx.pkgconfig.include = include/ include/recastnavigation/

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{recastnavigation}: bin.lib.version = "-$version.project_id"
else
  lib{recastnavigation}: bin.lib.version = "-$version.major.$version.minor"
